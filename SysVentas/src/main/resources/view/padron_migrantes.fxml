<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #f3f6fa;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.MigranteController">
    <top>
        <VBox spacing="5.0" style="-fx-background-color: #198754;">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <Label text="REGISTRO MIGRATORIO" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>
            <Label text="Padrón de migrantes" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="25.0"/>
                </font>
            </Label>
            <Label text="Sistema de registro y consulta de personas en proceso de migración" textFill="#dceaf7"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <TitledPane collapsible="false" expanded="true" text="Datos de la persona migrante">
                <GridPane hgap="12.0" style="-fx-background-color: white;" vgap="10.0">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="150.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="150.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Nombre completo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Nombres y apellidos"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="País de origen:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtPais" promptText="Ej. Venezuela"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Tipo de visa:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbVisa" maxWidth="Infinity" promptText="Seleccionar o escribir"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Fecha de ingreso:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="dpIngreso" maxWidth="Infinity" promptText="Seleccionar fecha"
                                GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Estatus migratorio:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <HBox alignment="CENTER_LEFT" spacing="20.0"
                          GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2">
                        <fx:define>
                            <ToggleGroup fx:id="grupoEstatus"/>
                        </fx:define>
                        <RadioButton fx:id="rbRegular" text="Regular" toggleGroup="$grupoEstatus"/>
                        <RadioButton fx:id="rbIrregular" text="Irregular" toggleGroup="$grupoEstatus"/>
                        <RadioButton fx:id="rbAsilo" text="Solicitante de asilo" toggleGroup="$grupoEstatus"/>
                    </HBox>
                </GridPane>
            </TitledPane>

            <HBox spacing="9.0">
                <Button onAction="#guardar" text="Guardar"
                        style="-fx-background-color: #247a4b; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button onAction="#actualizar" text="Actualizar"
                        style="-fx-background-color: #2463a6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button onAction="#eliminar" text="Eliminar"
                        style="-fx-background-color: #b83232; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button onAction="#limpiar" text="Limpiar"/>
                <Button onAction="#listar" text="Mostrar todos"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, país, estatus o ID" HBox.hgrow="ALWAYS"/>
                <Button onAction="#buscar" text="Buscar"/>
                <Label text="Consejo: selecciona una fila para cargar sus datos en el formulario."
                       textFill="#526579"/>
            </HBox>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="55.0" text="ID"/>
                    <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre completo"/>
                    <TableColumn fx:id="colPais" prefWidth="150.0" text="País de origen"/>
                    <TableColumn fx:id="colVisa" prefWidth="130.0" text="Tipo de visa"/>
                    <TableColumn fx:id="colIngreso" prefWidth="110.0" text="Fecha de ingreso"/>
                    <TableColumn fx:id="colEstatus" prefWidth="160.0" text="Estatus migratorio"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblEstado" text="Formulario listo." textFill="#1f4e79"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #e1eaf3;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Ejercicio 11 • Padrón de migrantes • JavaFX" textFill="#526579"/>
        </HBox>
    </bottom>
</BorderPane>
