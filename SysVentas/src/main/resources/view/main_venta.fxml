<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.VentaController">
   <children>
      <VBox layoutX="14.0" spacing="6.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
         <children>
            <!-- SECCIÓN 1: DATOS DEL CLIENTE -->
            <AnchorPane style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 6;">
               <children>
                  <GridPane hgap="6.0" vgap="4.0" AnchorPane.bottomAnchor="6.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="6.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="135.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="80.0" minWidth="65.0" prefWidth="70.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="90.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="160.0" prefWidth="180.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="140.0" prefWidth="160.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="80.0" minWidth="60.0" prefWidth="65.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="20.0" prefHeight="22.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="28.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Buscar DNI Cliente" />
                        <TextField fx:id="autocompCliente" promptText="Ej. 43631917" GridPane.rowIndex="1" />
                        <Button fx:id="btnFormCliente" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#buscarClienteCdni" text="Buscar" GridPane.columnIndex="1" GridPane.rowSpan="2" />
                        <Label text="DNI Cliente" GridPane.columnIndex="2" />
                        <TextField fx:id="dniRuc" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label text="Nombre Completo" GridPane.columnIndex="3" />
                        <TextField fx:id="razonSocial" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label text="Dirección" GridPane.columnIndex="4" />
                        <TextField fx:id="txtDireccion" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                        <Label text="Celular" GridPane.columnIndex="5" />
                        <TextField fx:id="txtCelular" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                        <Button fx:id="btnRegCliente" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarCliente" text="Add" GridPane.columnIndex="6" GridPane.rowSpan="2" />
                     </children>
                  </GridPane>
               </children>
            </AnchorPane>

            <!-- SECCIÓN 2: FILTRO DE CATÁLOGO Y SELECCIÓN DE FALLECIDO -->
            <AnchorPane style="-fx-background-color: #1f2d3d; -fx-background-radius: 6;">
               <children>
                  <GridPane hgap="10.0" vgap="4.0" AnchorPane.bottomAnchor="6.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="6.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="165.0" prefWidth="185.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="260.0" prefWidth="320.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="240.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="20.0" prefHeight="22.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="28.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: white;" text="1. Filtrar Tipo de Artículo" />
                        <ComboBox fx:id="cbxCategoriaVenta" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: white;" text="2. Selección Rápida (Ataúd o Flores)" GridPane.columnIndex="1" />
                        <ComboBox fx:id="cbxArticuloFunerario" maxWidth="1.7976931348623157E308" promptText="Elija un modelo del catálogo..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: white;" text="3. Fallecido Asociado (Padrón)" GridPane.columnIndex="2" />
                        <ComboBox fx:id="cbxDefuncion" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </AnchorPane>

            <!-- SECCIÓN 3: GALERÍA DE TARJETAS JAVA FX (PRECIO, TAMAÑO Y MATERIAL) -->
            <VBox spacing="4.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;" text="⚱️ Catálogo de Ataúdes y Flores (Precio, Tamaño y Material) — Haz clic en '🛒 Seleccionar' en cualquier tarjeta:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAbrirPanelAdmin" mnemonicParsing="false" onAction="#abrirModalPanelAdmin" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⚙️ Panel Administrador (Cambiar Precios / Agregar)" />
                     </children>
                  </HBox>
                  <ScrollPane fitToWidth="true" prefHeight="215.0" style="-fx-background-color: #f1f4f9; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
                     <content>
                        <FlowPane fx:id="contenedorTarjetasCatalogo" hgap="12.0" prefWrapLength="900.0" style="-fx-background-color: #f1f4f9; -fx-padding: 10;" vgap="12.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <!-- SECCIÓN 4: DETALLE DEL ARTÍCULO SELECCIONADO (MODELO, TAMAÑO, MATERIAL, PRECIO Y CANTIDAD) -->
            <AnchorPane style="-fx-background-color: #eef5ff; -fx-border-color: #b8daff; -fx-border-radius: 6;">
               <children>
                  <GridPane hgap="6.0" vgap="4.0" AnchorPane.bottomAnchor="6.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="6.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="140.0" prefWidth="165.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="145.0" prefWidth="170.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="180.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="65.0" minWidth="50.0" prefWidth="55.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="75.0" minWidth="60.0" prefWidth="65.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="75.0" minWidth="60.0" prefWidth="65.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="95.0" minWidth="75.0" prefWidth="85.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="95.0" minWidth="80.0" prefWidth="90.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="85.0" minWidth="65.0" prefWidth="75.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="20.0" prefHeight="22.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="28.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Modelo Seleccionado" />
                        <Label style="-fx-font-weight: bold;" text="Tamaño / Medidas" GridPane.columnIndex="1" />
                        <Label style="-fx-font-weight: bold;" text="Material" GridPane.columnIndex="2" />
                        <Label text="ID" GridPane.columnIndex="3" />
                        <Label text="Porc. Util." GridPane.columnIndex="4" />
                        <Label style="-fx-font-weight: bold;" text="Cant." GridPane.columnIndex="5" />
                        <Label style="-fx-font-weight: bold;" text="Precio S/." GridPane.columnIndex="6" />
                        <Label style="-fx-font-weight: bold;" text="Subtotal S/." GridPane.columnIndex="7" />
                        <Button fx:id="btnRegCarrito" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registarPCarrito" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="➕ Carrito" GridPane.columnIndex="8" GridPane.rowSpan="2" />
                        <TextField fx:id="nombreProducto" editable="false" GridPane.rowIndex="1" />
                        <TextField fx:id="txtTamanoSel" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="txtMaterialSel" editable="false" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="codigoPro" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <TextField fx:id="stockPro" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                        <TextField fx:id="cantidadPro" onKeyTyped="#calcularPT" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                        <TextField fx:id="punitPro" onKeyTyped="#calcularPT" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                        <TextField fx:id="preTPro" editable="false" GridPane.columnIndex="7" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </AnchorPane>

            <!-- SECCIÓN 5: TABLA DEL CARRITO DE COMPRAS -->
            <AnchorPane VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tableView" prefHeight="145.0" AnchorPane.bottomAnchor="2.0" AnchorPane.leftAnchor="2.0" AnchorPane.rightAnchor="2.0" AnchorPane.topAnchor="2.0" />
               </children>
            </AnchorPane>

            <!-- SECCIÓN 6: RESUMEN DE PAGO Y EMISIÓN DE COMPROBANTE -->
            <AnchorPane>
               <children>
                  <GridPane hgap="8.0" prefHeight="54.0" prefWidth="650.0" AnchorPane.bottomAnchor="2.0" AnchorPane.leftAnchor="4.0" AnchorPane.topAnchor="2.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="20.0" prefHeight="22.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="26.0" prefHeight="28.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Neto Total S/." />
                        <Label text="IGV (18%) S/." GridPane.columnIndex="1" />
                        <Label text="Descuento S/." GridPane.columnIndex="2" />
                        <Label style="-fx-font-weight: bold;" text="Precio Total S/." GridPane.columnIndex="3" />
                        <Button fx:id="btnRegVenta" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarVenta" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" text="Emitir Venta / Boleta" GridPane.columnIndex="4" GridPane.rowSpan="2" />
                        <TextField fx:id="txtBaseImp" editable="false" GridPane.rowIndex="1" />
                        <TextField fx:id="txtIgv" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="txtDescuento" text="0.00" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtImporteT" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
