<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="275.0" prefWidth="370.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.RegistroController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Registro de Nuevo Usuario" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <GridPane hgap="10.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="180.0" prefWidth="200.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="32.0" prefHeight="34.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="32.0" prefHeight="34.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="32.0" prefHeight="34.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Nombre de Usuario:" />
                  <TextField fx:id="txtNuevoUsuario" promptText="Ej. juanperez" GridPane.columnIndex="1" />
                  <Label text="Contraseña:" GridPane.rowIndex="1" />
                  <PasswordField fx:id="txtNuevaClave" promptText="Ingrese contraseña" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Confirmar Clave:" GridPane.rowIndex="2" />
                  <PasswordField fx:id="txtConfirmarClave" promptText="Repita la contraseña" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <Label fx:id="lblEstado" alignment="CENTER" maxWidth="1.7976931348623157E308" text="" wrapText="true" />
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#registrarCuenta" prefHeight="34.0" prefWidth="150.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrarme" />
                  <Button mnemonicParsing="false" onAction="#cancelar" prefHeight="34.0" prefWidth="120.0" text="Cancelar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
