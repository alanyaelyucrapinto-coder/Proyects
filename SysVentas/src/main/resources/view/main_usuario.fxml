<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.UsuarioController">
   <children>
      <VBox layoutX="14.0" layoutY="14.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
         <children>
            <AnchorPane maxWidth="1.7976931348623157E308">
               <children>
                  <Label layoutX="21.0" layoutY="14.0" text="Panel de Gestión de Usuarios y Roles" textFill="#3971c6">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="10.0" />
               </padding>
            </AnchorPane>
            <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
               <children>
                  <HBox spacing="12.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                     <children>
                        <AnchorPane prefWidth="340.0">
                           <children>
                              <GridPane hgap="8.0" vgap="8.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="90.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="30.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="30.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="30.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="30.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="35.0" prefHeight="38.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="30.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Datos del Usuario" GridPane.columnSpan="3">
                                       <font>
                                          <Font name="System Bold" size="13.0" />
                                       </font>
                                    </Label>
                                    <Label text="Usuario:" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtUsuarioNombre" promptText="Nombre de usuario" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                                    <Label text="Contraseña:" GridPane.rowIndex="2" />
                                    <PasswordField fx:id="txtUsuarioClave" promptText="Clave de acceso" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                                    <Label text="Perfil / Rol:" GridPane.rowIndex="3" />
                                    <ComboBox fx:id="cbxPerfil" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarUsuario" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearForm" text="Cancelar" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                                    <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" text="" wrapText="true" GridPane.columnSpan="3" GridPane.rowIndex="5" />
                                 </children>
                              </GridPane>
                           </children>
                        </AnchorPane>
                        <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                           <children>
                              <TableView fx:id="tableView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
